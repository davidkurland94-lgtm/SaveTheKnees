# The build context must stay small. data/ alone is 17 GB and the venvs are
# multi-GB -- without this, every build ships them to the Docker daemon.
data/
save-the-knees-env/
.venv/
.git/
notebooks/
Docs/
david_not_public/
api/
.env

# The React front end. 471 MB of node_modules, and the serving image COPYs
# only functions/, serving/ and models/ -- none of this has ever been in the
# container. Without this line every build ships half a gigabyte.
Frontend/

**/__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/

requirements-dev.txt
*.md
.DS_Store

# Serving needs one checkpoint: knee_findings.keras. Every other .keras is a
# training byproduct -- seed variants, superseded recipes -- and has no
# business inflating the image.
models/knee_findings_25d.keras
models/knee_findings_aug.keras
models/knee_fusion*.keras
models/knee_multiplane*.keras
