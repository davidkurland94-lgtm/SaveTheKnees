# Copy to .env for local runs:  cp .env.example .env
# .env is gitignored. NEVER commit the real one, and never put a credential in
# THIS file -- it is committed, and is documentation only.

# Where the dataset lives. Locally the repo's data/; in Cloud Run the
# read-only GCS mount.
DATA_ROOT=./data

# Where uploads and stored reports go. Must be WRITABLE. Kept separate from
# DATA_ROOT because the Cloud Run dataset mount is read-only.
WRITE_ROOT=./data/_tmp

# The serving checkpoint. Absent -> the API answers with model_status
# "untrained" instead of crashing.
MODEL_PATH=./models/knee_findings.keras

# Comma-separated browser origins allowed to call the API.
# "*" is fine while developing; pin it once the front end has a domain,
# because there is no authentication on this service.
ALLOWED_ORIGINS=*

# Cloud Run injects this. Only used locally.
PORT=8080
