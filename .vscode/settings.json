{
  // The project env is save-the-knees-env (see README / .python-version).
  // VS Code defaults to .venv by convention, which here holds only lint and
  // notebook tooling -- none of tensorflow, fastapi, pydicom, pandas or keras.
  // Without this line Pylance reports "Import could not be resolved" for all
  // of them while the code runs perfectly from the terminal.
  "python.defaultInterpreterPath": "${workspaceFolder}/save-the-knees-env/Scripts/python.exe",

  // functions/ and api/ are imported as namespace packages from the repo root
  // (`from functions.model import ...`), so the root must be on the path.
  "python.analysis.extraPaths": ["${workspaceFolder}"],
  "python.analysis.typeCheckingMode": "basic",

  "python.terminal.activateEnvironment": true
}
